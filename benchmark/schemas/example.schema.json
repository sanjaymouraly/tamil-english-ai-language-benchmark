{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TEB Benchmark Example",
  "description": "Schema for one Tamil-English Benchmark (TEB) example, version 1.0.0.",
  "type": "object",
  "required": ["id", "category", "task_type", "direction", "source_text", "source_script", "expected_behavior", "references", "difficulty"],
  "properties": {
    "id": {"type": "string", "pattern": "^TEB-[A-Z]{2,4}-[0-9]{4}$"},
    "version": {"type": "string", "default": "1.0.0"},
    "category": {"type": "string", "enum": ["translation_ta_to_en", "translation_en_to_ta", "code_mixed_understanding", "romanized_transliteration", "register_formality", "instruction_following", "customer_support", "business_email", "idiom_culture", "ambiguity_context", "technical_terminology", "summarization_rewriting", "entities_numbers", "long_context_multiturn", "language_switching", "safety_critical"]},
    "task_type": {"type": "string"},
    "direction": {"type": "string"},
    "source_text": {"type": "string", "minLength": 1},
    "source_script": {"type": "string", "enum": ["tamil", "latin", "mixed"]},
    "source_language": {"type": "string"},
    "target_language": {"type": "string"},
    "expected_behavior": {"type": "string", "minLength": 1},
    "references": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "glossary": {"type": "array", "items": {"type": "object", "required": ["term", "translation", "language"], "properties": {"term": {"type": "string"}, "translation": {"type": "string"}, "language": {"type": "string", "enum": ["ta", "en"]}, "case_sensitive": {"type": "boolean"}}}},
    "context": {"type": "string"},
    "difficulty": {"type": "string", "enum": ["easy", "medium", "hard"]},
    "register": {"type": "string", "enum": ["formal", "informal", "neutral"]},
    "phenomena": {"type": "array", "items": {"type": "string"}},
    "critical_constraints": {"type": "array", "items": {"type": "object", "required": ["kind", "value"], "properties": {"kind": {"type": "string", "enum": ["must_contain", "must_not_contain", "regex", "numeric_preservation", "entity_preservation"]}, "value": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}, "minItems": 1}]}, "description": {"type": "string"}}}},
    "provenance": {"type": "string", "enum": ["synthetic", "public_domain", "licensed", "user_contributed"]},
    "provenance_note": {"type": "string"},
    "license": {"type": "string"},
    "annotation_notes": {"type": "string"},
    "partition": {"type": ["string", "null"], "enum": ["train", "dev", "test", null]},
    "verification_status": {"type": "string", "enum": ["machine_validated", "agent_reviewed", "human_reviewed", "adjudicated"]},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
