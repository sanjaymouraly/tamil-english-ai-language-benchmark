# Environment configuration template — copy to .env and fill in values.
# NEVER commit real API keys. Keys are read from environment variables only
# and are never written to the database or logs.

# --- General ---
TEB_ENV=development
TEB_DATA_DIR=./data
TEB_DB_PATH=./data/teb.db
TEB_LOG_LEVEL=INFO

# --- AI Providers (leave empty to use offline/mock mode; no paid API required) ---
# Both the bare name (OPENAI_API_KEY) and the TEB_-prefixed name
# (TEB_OPENAI_API_KEY) are accepted. The TEB_ form takes precedence.
# OpenAI API (api.openai.com) — NOTE: requires OpenAI API credits, NOT a ChatGPT Plus subscription.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude API
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=

# Custom OpenAI-compatible endpoint (e.g. vLLM, LiteLLM, Azure OpenAI)
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=

# Local Ollama (OpenAI-compatible endpoint)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# LM Studio (OpenAI-compatible endpoint)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model

# --- Spending controls ---
TEB_MAX_COST_USD=1.00
TEB_MAX_REQUESTS_PER_JOB=500
TEB_REQUEST_TIMEOUT_SECONDS=60
TEB_MAX_CONCURRENCY=4
